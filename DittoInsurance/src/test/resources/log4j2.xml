
<Configuration status="WARN">

<properties>

<property name="basepath">./logs</property>

</properties>

  <Appenders>

    <Console name="Console">

      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>

    </Console>

   

    <RollingFile name="File" fileName="${basepath}/DittoAutomationReport.log"

    filepattern="${basepath}/DittoAutomationReport-%d{yyyy-MM-dd}.log">

      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>

      <SizeBasedTriggeringPolicy size="5000"/>

    </RollingFile>

  </Appenders>

 

  <Loggers>

    <Root level="Debug">

    <AppenderRef ref="File"/>

   

       <AppenderRef ref="Console"/>

    </Root>

  </Loggers>

</Configuration>